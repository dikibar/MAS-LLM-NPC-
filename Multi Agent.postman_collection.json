          "cookie": [],
          "body": "{\n  \"status\": \"success\",\n  \"message\": \"Simulation executed successfully\",\n  \"data\": {\n    \"simulation_id\": \"9f8fbd41-8d03-4ed4-bf78-7f20c2c6ddc2\",\n    \"context\": {\n      \"timestamp\": \"12:30:00\",\n      \"scene\": \"Heritage_Museum_Wing_A\",\n      \"events\": [\n        \"Main_Gate:OPEN\",\n        \"Spotlight_Altar:ON\"\n      ],\n      \"user_action\": \"Examining_Artifact_ID_7\",\n      \"recommendations\": [\n        {\n          \"rank\": 1,\n          \"id\": \"Angklung\",\n          \"name\": \"Angklung\",\n          \"cultural_position\": \"14.62413, 1.37554, 18.67057\"\n        },\n        {\n          \"rank\": 2,\n          \"id\": \"Surabi\",\n          \"name\": \"Surabi\",\n          \"cultural_position\": \"-1.34956, 1.52654, 23.7432\"\n        }\n      ],\n      \"nav_target\": \"Angklung\"\n    },\n    \"navmesh_ack\": true,\n    \"dialogue\": {\n      \"spoken_output\": \"Saya sudah menyiapkan beberapa rekomendasi objek budaya di sekitar Anda. Silakan pilih tujuan yang paling ingin Anda kunjungi, dan saya akan membantu memandu perjalanannya.\",\n      \"subtitle_output\": \"Silakan pilih tujuan budaya berikutnya.\",\n      \"recommendation_dialogue\": \"Di sekitar posisi Anda ada beberapa objek budaya menarik. Pilih salah satu, dan saya akan memandu navigasinya.\",\n      \"recommendation_options\": [\n        \"Angklung\",\n        \"Surabi\"\n      ]\n    }\n  }\n}"
        },
