# LLM API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1
USE_MOCK_MODEL=true

# Use a model different from OPENROUTER_MODEL to reduce self-preference bias.
# JUDGE_API_KEY and JUDGE_BASE_URL fall back to the OpenRouter values above.
JUDGE_MODEL=gpt-5.4
JUDGE_API_KEY=your_judge_api_key_here
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MAX_RETRIES=3

# Azure Foundry/OpenAI can use the same variables above:
# OPENROUTER_API_KEY=your_azure_resource_key
# OPENROUTER_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
# OPENROUTER_MODEL=your_deployment_name
# USE_MOCK_MODEL=false

# Project Settings
PROJECT_NAME=MultiAgentSystem
LOG_LEVEL=INFO
